# ============================================================
#  SHIBAWRITE BACKEND — ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git — it holds your minter private key.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
# Example for a local Postgres instance:
DATABASE_URL="postgresql://postgres:password@localhost:5432/shibawrite?schema=public"

# --- Auth ---
# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRY_SECONDS=86400
SESSION_COOKIE_NAME=shibawrite_session

# --- Blockchain / Base Network ---
# Base Sepolia (testnet) RPC — get a free one from Alchemy, Infura, or use the public one
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Deployed ShibaWrite.sol contract address
CONTRACT_ADDRESS=0xYourDeployedShibaWriteAddress

# Private key of the wallet holding MINTER_ROLE on ShibaWrite.sol.
# This wallet signs every EIP-712 reward claim. Guard this like a bank password.
MINTER_PRIVATE_KEY=0xYourMinterWalletPrivateKey

# --- Content Scoring APIs ---
# Winston AI — AI-generation + plagiarism detection
# Free signup, no credit card required, 2,500 free credits.
# Get your key at: https://dev.gowinston.ai/register
WINSTON_AI_API_KEY=your_winston_ai_api_key

# Google Gemini — used for the quality/coherence/depth scoring dimension.
# Genuinely free tier (rate-limited, not credit-metered), no credit card
# required, does not expire like a trial credit. Get your key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
